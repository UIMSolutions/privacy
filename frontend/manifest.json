{
  "_version": "1.59.0",
  "sap.app": {
    "id": "uim.gdpr",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/gdpr/",
        "type": "OData",
        "settings": { "odataVersion": "4.0", "localUri": "localService/metadata.xml" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "rootView": { "viewName": "uim.gdpr.view.App", "type": "XML", "id": "app" },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.f": {}, "sap.ui.layout": {} }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "uim.gdpr.i18n.i18n", "supportedLocales": ["", "de", "en"], "fallbackLocale": "" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": false,
          "earlyRequests": true,
          "groupId": "$direct",
          "updateGroupId": "$direct"
        }
      }
    },
    "resources": { "css": [{ "uri": "css/style.css" }] },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "uim.gdpr.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true,
        "bypassed": { "target": "main" }
      },
      "routes": [
        { "name": "main", "pattern": "", "target": "main" },
        { "name": "project", "pattern": "project/{projectId}", "target": "project" }
      ],
      "targets": {
        "main": { "id": "main", "name": "Main", "level": 1 },
        "project": { "id": "project", "name": "Project", "level": 2 }
      }
    }
  }
}
