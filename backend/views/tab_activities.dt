.row
  h6.max.no-margin Record of processing activities (Art. 30)
  button(data-open="dlg-new-activity")
    i add
    span New activity
- if (activities.length == 0)
  p.grey-text No processing activities recorded yet.
- else
  .table-wrap
    table.stripes
      thead
        tr
          th Name
          th Legal basis
          th Risk
          th DPIA
          th Transfer
          th Status
          th
      tbody
        - foreach (a; activities)
          tr
            td
              div #{a.name}
              .small-text.grey-text #{a.purpose}
            td
              div #{label(a.legalBasis)}
              .small-text.grey-text #{a.legalBasisArticle}
            td
              span(class="chip small #{tone(a.riskLevel)}") #{label(a.riskLevel)}
            td
              - if (!a.dpiaRequired)
                span.grey-text not required
              - else if (a.dpiaCompleted)
                span.green-text completed
              - else
                span.red-text required
            td
              - if (!a.thirdCountryTransfer)
                span.grey-text –
              - else if (a.transferSafeguard.length)
                span #{a.transferSafeguard}
              - else
                span.red-text no safeguard
            td
              span(class="chip small #{tone(a.status)}") #{label(a.status)}
            td.right-align.nowrap
              button.circle.transparent(data-open="dlg-act-#{a.ID}", title="Edit")
                i edit
              button.circle.transparent(hx-post="/web/activities/#{a.ID}/delete", hx-target="#panel", hx-confirm="Delete processing activity '#{a.name}'?", title="Delete")
                i delete
              dialog.large(id="dlg-act-#{a.ID}")
                h5 Edit processing activity
                form.left-align(hx-post="/web/activities/#{a.ID}", hx-target="#panel")
                  include form_activity
                  nav.right-align
                    button.border(type="button", data-close) Cancel
                    button(type="submit") Save

dialog.large#dlg-new-activity
  h5 New processing activity
  - auto a = ProcessingActivityDto.init;
  - a.legalBasis = "contract";
  - a.status = "draft";
  form(hx-post="/web/projects/#{project.ID}/activities", hx-target="#panel")
    include form_activity
    nav.right-align
      button.border(type="button", data-close) Cancel
      button(type="submit") Create
