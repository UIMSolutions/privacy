{
  "name": "gdpr",
  "description": "GDPR (DSGVO) privacy project management – vibe.d backend (OData v4, BeerCSS/htmx web GUI, webview, CLI)",
  "license": "Apache-2.0",
  "targetType": "executable",
  "targetName": "gdpr",
  "targetPath": "build/bin",
  "sourcePaths": ["source"],
  "importPaths": ["source"],
  "stringImportPaths": ["views"],
  "dependencies": {
    "vibe-d": "~>0.10.3",
    "openssl": "~>3.4.0"
  },
  "subConfigurations": { "openssl": "library-autodetect" },
  "configurations": [
    { "name": "application" },
    {
      "name": "unittest",
      "targetName": "gdpr-test",
      "sourcePaths": ["source", "tests"],
      "importPaths": ["source", "tests"],
      "versions": ["GdprUnittest"]
    }
  ]
}
